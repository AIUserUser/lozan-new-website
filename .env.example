APP_NAME=Lozan
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://lozan-kw.com

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lozan
DB_USERNAME=lozan
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@lozan-kw.com"
MAIL_FROM_NAME="${APP_NAME}"

ADMIN_EMAIL=admin@lozan-kw.com
ADMIN_PASSWORD=
ADMIN_WHATSAPP=

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

SUPABASE_URL=
SUPABASE_ANON_KEY=
